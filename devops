<script>
function showView(name) {
  document.querySelectorAll('.section-content').forEach(el => el.classList.remove('visible'));
  document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('visible');
  document.getElementById('btn-' + name).classList.add('active');
}

function filterPhase(phase, el) {
  document.querySelectorAll('.phase-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.resource-card[data-phase]').forEach(card => {
    if (phase === 'all' || card.dataset.phase === phase || card.dataset.phase === 'all') {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}
</script>

