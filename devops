<style>
  :root {
    --bg: #0a0e1a;
    --surface: #111827;
    --card: #161e2e;
    --border: #1f2d42;
    --accent: #00e5ff;
    --green: #00ff88;
    --orange: #ff7c3a;
    --purple: #a78bfa;
    --pink: #f472b6;
    --text: #e2eaf4;
    --muted: #6b7fa3;
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }

- { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

body {
font-family: ‘Syne’, sans-serif;
background: var(–bg);
color: var(–text);
min-height: 100dvh;
padding-top: calc(var(–safe-top) + 16px);
padding-bottom: calc(var(–safe-bottom) + 80px);
overflow-x: hidden;
}

/* Background grid */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background-image:
linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
background-size: 40px 40px;
pointer-events: none;
z-index: 0;
}

.container { position: relative; z-index: 1; padding: 0 16px; max-width: 430px; margin: 0 auto; }

/* Header */
.header { padding: 12px 0 20px; }
.header-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.logo {
font-size: 11px;
font-family: ‘JetBrains Mono’, monospace;
color: var(–accent);
letter-spacing: 0.15em;
text-transform: uppercase;
}
.status-pill {
display: flex; align-items: center; gap: 6px;
background: rgba(0,255,136,0.08);
border: 1px solid rgba(0,255,136,0.2);
border-radius: 20px;
padding: 4px 10px;
font-size: 10px;
color: var(–green);
font-family: ‘JetBrains Mono’, monospace;
}
.status-dot {
width: 6px; height: 6px;
border-radius: 50%;
background: var(–green);
animation: pulse 2s infinite;
}
@keyframes pulse {
0%,100% { opacity: 1; transform: scale(1); }
50% { opacity: 0.4; transform: scale(0.8); }
}

.headline {
font-size: 28px;
font-weight: 800;
line-height: 1.15;
margin-bottom: 6px;
}
.headline span { color: var(–accent); }
.subhead {
font-size: 13px;
color: var(–muted);
font-family: ‘JetBrains Mono’, monospace;
line-height: 1.5;
}

/* Phase nav tabs */
.phase-nav {
display: flex;
gap: 6px;
overflow-x: auto;
scrollbar-width: none;
padding: 4px 0 16px;
}
.phase-nav::-webkit-scrollbar { display: none; }
.phase-tab {
flex-shrink: 0;
padding: 7px 14px;
border-radius: 20px;
font-size: 11px;
font-weight: 700;
letter-spacing: 0.04em;
cursor: pointer;
border: 1.5px solid var(–border);
background: var(–card);
color: var(–muted);
transition: all 0.2s;
white-space: nowrap;
}
.phase-tab.active {
background: var(–accent);
border-color: var(–accent);
color: #000;
}

/* Section label */
.section-label {
font-size: 10px;
font-family: ‘JetBrains Mono’, monospace;
color: var(–muted);
letter-spacing: 0.12em;
text-transform: uppercase;
margin-bottom: 10px;
margin-top: 4px;
display: flex;
align-items: center;
gap: 8px;
}
.section-label::after {
content: ‘’;
flex: 1;
height: 1px;
background: var(–border);
}

/* Pipeline flow */
.pipeline {
display: flex;
align-items: center;
gap: 0;
overflow-x: auto;
scrollbar-width: none;
padding-bottom: 4px;
margin-bottom: 20px;
}
.pipeline::-webkit-scrollbar { display: none; }
.pipe-step {
flex-shrink: 0;
background: var(–card);
border: 1px solid var(–border);
border-radius: 10px;
padding: 10px 12px;
text-align: center;
min-width: 76px;
position: relative;
cursor: pointer;
transition: all 0.2s;
}
.pipe-step:active { transform: scale(0.95); }
.pipe-step.done { border-color: var(–green); }
.pipe-step.active-step { border-color: var(–accent); background: rgba(0,229,255,0.07); }
.pipe-step .pipe-icon { font-size: 18px; margin-bottom: 4px; }
.pipe-step .pipe-name { font-size: 9px; font-family: ‘JetBrains Mono’, monospace; color: var(–muted); text-transform: uppercase; letter-spacing: 0.08em; }
.pipe-arrow { color: var(–border); font-size: 14px; padding: 0 2px; flex-shrink: 0; }

/* Resource cards */
.resource-card {
background: var(–card);
border: 1px solid var(–border);
border-radius: 14px;
padding: 14px 15px;
margin-bottom: 10px;
display: flex;
align-items: flex-start;
gap: 13px;
cursor: pointer;
transition: all 0.2s;
text-decoration: none;
color: inherit;
position: relative;
overflow: hidden;
}
.resource-card::before {
content: ‘’;
position: absolute;
left: 0; top: 0; bottom: 0;
width: 3px;
border-radius: 3px 0 0 3px;
}
.resource-card.clr-cyan::before { background: var(–accent); }
.resource-card.clr-green::before { background: var(–green); }
.resource-card.clr-orange::before { background: var(–orange); }
.resource-card.clr-purple::before { background: var(–purple); }
.resource-card.clr-pink::before { background: var(–pink); }
.resource-card:active { transform: scale(0.98); border-color: var(–accent); }

.card-icon {
width: 40px; height: 40px;
border-radius: 10px;
display: flex; align-items: center; justify-content: center;
font-size: 20px;
flex-shrink: 0;
background: rgba(255,255,255,0.04);
}
.card-body { flex: 1; min-width: 0; }
.card-title { font-size: 14px; font-weight: 700; margin-bottom: 2px; }
.card-desc { font-size: 11px; color: var(–muted); line-height: 1.5; margin-bottom: 6px; }
.card-tags { display: flex; flex-wrap: wrap; gap: 4px; }
.tag {
font-size: 9px;
font-family: ‘JetBrains Mono’, monospace;
padding: 2px 7px;
border-radius: 20px;
font-weight: 700;
letter-spacing: 0.05em;
text-transform: uppercase;
}
.tag-free { background: rgba(0,255,136,0.12); color: var(–green); }
.tag-beginner { background: rgba(0,229,255,0.1); color: var(–accent); }
.tag-intermediate { background: rgba(255,124,58,0.12); color: var(–orange); }
.tag-advanced { background: rgba(167,139,250,0.12); color: var(–purple); }
.tag-cert { background: rgba(244,114,182,0.12); color: var(–pink); }
.card-arrow { font-size: 16px; color: var(–muted); flex-shrink: 0; align-self: center; }

/* Roadmap track */
.roadmap { margin-bottom: 4px; }
.roadmap-item {
display: flex;
gap: 14px;
padding-bottom: 18px;
position: relative;
}
.roadmap-item::before {
content: ‘’;
position: absolute;
left: 15px; top: 32px;
width: 1px; bottom: 0;
background: var(–border);
}
.roadmap-item:last-child::before { display: none; }
.rm-dot {
width: 30px; height: 30px;
border-radius: 50%;
border: 2px solid var(–border);
display: flex; align-items: center; justify-content: center;
font-size: 13px;
flex-shrink: 0;
background: var(–card);
position: relative;
z-index: 1;
}
.rm-dot.done { border-color: var(–green); background: rgba(0,255,136,0.1); }
.rm-dot.now { border-color: var(–accent); background: rgba(0,229,255,0.1); animation: glow 2s infinite; }
@keyframes glow {
0%,100% { box-shadow: 0 0 0 0 rgba(0,229,255,0.4); }
50% { box-shadow: 0 0 0 6px rgba(0,229,255,0); }
}
.rm-content { flex: 1; padding-top: 4px; }
.rm-title { font-size: 13px; font-weight: 700; margin-bottom: 2px; }
.rm-tools { font-size: 10px; font-family: ‘JetBrains Mono’, monospace; color: var(–muted); line-height: 1.6; }

/* Bottom nav */
.bottom-nav {
position: fixed;
bottom: 0; left: 0; right: 0;
padding-bottom: var(–safe-bottom);
background: rgba(10,14,26,0.95);
backdrop-filter: blur(20px);
-webkit-backdrop-filter: blur(20px);
border-top: 1px solid var(–border);
display: flex;
z-index: 100;
}
.nav-btn {
flex: 1;
display: flex; flex-direction: column;
align-items: center; justify-content: center;
padding: 10px 0 12px;
cursor: pointer;
color: var(–muted);
font-size: 9px;
font-family: ‘JetBrains Mono’, monospace;
letter-spacing: 0.06em;
text-transform: uppercase;
gap: 4px;
transition: color 0.2s;
border: none; background: none;
}
.nav-btn.active { color: var(–accent); }
.nav-btn .nav-icon { font-size: 20px; }

/* Sections visibility */
.section-content { display: none; }
.section-content.visible { display: block; }

/* Progress bar */
.progress-wrap { margin-bottom: 18px; }
.progress-title { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 11px; }
.progress-title span:last-child { font-family: ‘JetBrains Mono’, monospace; color: var(–accent); }
.progress-bar { height: 6px; background: var(–border); border-radius: 3px; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(–accent), var(–green)); transition: width 0.5s ease; }

/* Tip box */
.tip-box {
background: rgba(0,229,255,0.05);
border: 1px solid rgba(0,229,255,0.15);
border-radius: 12px;
padding: 12px 14px;
margin-bottom: 14px;
font-size: 12px;
color: var(–muted);
line-height: 1.6;
}
.tip-box strong { color: var(–accent); }

.fade-in { animation: fadeUp 0.4s ease both; }
@keyframes fadeUp {
from { opacity: 0; transform: translateY(12px); }
to { opacity: 1; transform: translateY(0); }
}
</style>

</head>
